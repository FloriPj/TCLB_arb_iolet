			weightedNormal.x += weight * 1; weightedNormal.y += weight * 1; weightedNormal.z += weight * 1; totalWeight += weight;
		}
	}
	// Direction (-1, -1, 0)
	{
		const cut_t q = Q220;
		if (q != NO_CUT) {
			if (minCut == NO_CUT || q < minCut) minCut = q;
