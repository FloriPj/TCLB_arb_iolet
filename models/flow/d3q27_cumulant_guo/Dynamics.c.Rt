	}
	// Direction (-1, 1, -1)
	{
		const cut_t q = Q212;
		if (q != NO_CUT) {
			if (minCut == NO_CUT || q < minCut) minCut = q;
			const real_t weight = 1.0 / (((real_t)q / (real_t)CUT_MAX) + 1e-6);
			weightedNormal.x += weight * 1; weightedNormal.z += weight * 1; totalWeight += weight;
		}
	}
	// Direction (-1, 1, 0)
	{
		const cut_t q = Q210;
		if (q != NO_CUT) {
			if (minCut == NO_CUT || q < minCut) minCut = q;
			const real_t weight = 1.0 / (((real_t)q / (real_t)CUT_MAX) + 1e-6);
			weightedNormal.x += weight * 1; weightedNormal.z += weight * (-1); totalWeight += weight;
		}
	}
	// Direction (0, 1, -1)
	{
		const cut_t q = Q012;
		if (q != NO_CUT) {
			if (minCut == NO_CUT || q < minCut) minCut = q;
			const real_t weight = 1.0 / (((real_t)q / (real_t)CUT_MAX) + 1e-6);
			weightedNormal.x += weight * (-1); weightedNormal.z += weight * 1; totalWeight += weight;
		}
	}
	// Direction (0, 1, 0)
	{
		const cut_t q = Q010;
		if (q != NO_CUT) {
			if (minCut == NO_CUT || q < minCut) minCut = q;
			const real_t weight = 1.0 / (((real_t)q / (real_t)CUT_MAX) + 1e-6);
			weightedNormal.x += weight * (-1); weightedNormal.z += weight * (-1); totalWeight += weight;
		}
	}
	// Direction (1, -1, -1)
	{
		const cut_t q = Q122;
		if (q != NO_CUT) {
			if (minCut == NO_CUT || q < minCut) minCut = q;
			const real_t weight = 1.0 / (((real_t)q / (real_t)CUT_MAX) + 1e-6);
			weightedNormal.y += weight * 1; weightedNormal.z += weight * 1; totalWeight += weight;
